ENCE PATH"}],["$","h3",null,{"children":"证据持续留痕"}],["$","p",null,{"children":"raw content → revisions → resolved / review → verified / provisional"}]]}],["$","article",null,{"children":[["$","span",null,{"children":"QUERY PATH"}],["$","h3",null,{"children":"问题进入系统"}],["$","p",null,{"children":"fast / rewrite / bypass → 多查询召回 → RRF → Rerank → Top-K"}]]}]]}],["$","p",null,{"className":"section-intro top-gap","children":"MySQL 保存页面、资产、Block 和全部 Revision，Milvus 只承载检索需要的 Chunk 元数据与向量；解析事实层与检索索引分开维护。"}]]}]]}],["$","section",null,{"className":"case-section","id":"ingest","children":[["$","div",null,{"className":"case-section-heading","children":[["$","span",null,{"children":"02 / INGEST"}],["$","h2",null,{"children":"从 PDF 到可索引证据"}]]}],["$","div",null,{"className":"case-section-body","children":["$","ol",null,{"className":"case-pipeline","children":[["$","li","01",{"children":[["$","span",null,{"children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"PDF 预检"}],["$","p",null,{"children":"校验文件与加密状态，记录页尺寸、旋转角和 SHA-256 文档身份。"}]]}]]}],["$","li","02",{"children":[["$","span",null,{"children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"MinerU 解析"}],["$","p",null,{"children":"上传完整 PDF，取得 content_list、版面块和图片资产；ZIP 解压前检查路径穿越。"}]]}]]}],["$","li","03",{"children":[["$","span",null,{"children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"统一证据图"}],["$","p",null,{"children":"把 Page、Block、Asset、Revision 归一化，保留 MinerU 原始顺序与原始内容。"}]]}]]}],["$","li","04",{"children":[["$","span",null,{"children":"04"}],["$","div",null,{"children":[["$","strong",null,{"children":"页级反向审计"}],["$","p",null,{"children":"用 PDF 文本层、bbox 与可见墨迹检查漏块、数字差异、脚注冲突和遮挡区域。"}]]}]]}],["$","li","05",{"children":[["$","span",null,{"children":"05"}],["$","div",null,{"children":[["$","strong",null,{"children":"VLM 定向修复"}],["$","p",null,{"children":"只将命中质量 Flag 的文字、表格、图表和公式路由到对应视觉任务。"}]]}]]}],["$","li","06",{"children":[["$","span",null,{"children":"06"}],["$","div